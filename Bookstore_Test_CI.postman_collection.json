    {
      "name": "Unavaliable Book",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "exec": [
              ""
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        },
        {
          "listen": "test",
          "script": {
            "exec": [
              "//\r",
              "const Unavail = pm.response.json();\r",
              "\r",
              "//#2 logic\r",
              "\r",
              "// filter books that are not available\r",
              "const unavailableBooks = Unavail.filter(book => book.available === false);\r",
              "let hasUnavailableBooks = false;\r",
              "\r",
              "if (unavailableBooks.length > 0) {\r",
              "    // get the id of the first unavailable book\r",
              "    const unavailableBookID = unavailableBooks[0];\r",
              "\r",
              "    // set the global variable for unavailable book\r",
              "    pm.globals.set(\"unavailableBook\", unavailableBookID.id);\r",
              "    // log the unavailable book to the console\r",
              "    console.log(\"Unavailable Book:\", unavailableBookID);\r",
              "\r",
              "    // set flag to true\r",
              "    hasUnavailableBooks = true;\r",
              "\r",
              "} else {\r",
              "    console.log(\"No unavailable books found.\");\r",
              "    hasUnavailableBooks = false;\r",
              "}\r",
              "//#3 assertion\r",
              "\r",
              "\r",
              "pm.test( \"validate book availability, unavailable book found\", function(){\r",
              "    pm.response.to.have.status(200);\r",
              "\r",
              "    if (hasUnavailableBooks === true){\r",
              "        // happy path of unavailable books\r",
              "        pm.expect(unavailableBooks).to.be.an('Array');\r",
              "        pm.expect(unavailableBooks).to.have.length.above(0);\r",
              "    }\r",
              "\r",
              "    else{\r",
              "        // control failure path\r",
              "        pm.expect.fail(\"No unavailable books found\");\r",
              "    }\r",
              "}\r",
              "\r",
              ")\r",
              ""
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        }
      ],
