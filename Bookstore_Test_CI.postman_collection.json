              "});\r",
              "\r",
              "// filtering data that not hard code based on variable\r",
              "const response = pm.response.json();\r",
              "const selectedBook = response.filter((book) => book.type === \"non-fiction\" && book.available === true);\r",
              "\r",
              "// Show all books\r",
              "//console.log(selectedBook);\r",
              "\r",
              "// Use first book ID based on array []\r",
              "console.log(selectedBook[0]);\r",
              "\r",
              "// set the variable to global so that can be used in other tests\r",
              "// if want to use book id value in other test, at the end of script use = .id\r",
              "pm.globals.set(\"filtered_book\", selectedBook[0].id);\r",
              "\r",
              "//above log >> console.log(selectedBook[0]);>> is \"standard\" log that restored in \"console\", to generate more detail log for \"test result\" tab, we can elaborate by :\r",
              "const book = selectedBook [0];\r",
              "//check if book is available and type is non-fiction (as per parameter)\r",
              "pm.test(\"Book is found\", () =>{\r",
              "    pm.expect(book).to.be.an('object');\r",
