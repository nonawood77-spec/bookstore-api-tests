    {
      "name": "BASIC LOGIC",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "const storeres = pm.response.json();\r",
              "\r",
              "// before writing test check console, is it : object or array, what key exists\r",
              "// console.log(storeres);\r",
              "\r",
              "// check response before writing logic\r",
              "/* GOAL logic = example is to check whether the stock is available\r",
              "Before writing logic, always ask:\r",
              "Step 1 \u2014 What did I receive?\r",
              "[] \u2192 array \u2192 use filter, map, [0]\r",
              "{} \u2192 object \u2192 use .field\r",
              "\r",
              "Correct patterns (memorize these)\r",
              "If response is an array\r",
              "response.filter(item => item.available === true);\r",
              "response[0].available;\r",
              "\r",
              "If response is an object\r",
              "response.available === true;\r",
              "*/\r",
              "\r",
              "const stock = storeres.filter (function(bookstock){\r",
              "    return bookstock.available === true && bookstock.type === \"fiction\";})\r",
              "\r",
              "\r",
              "// GOAL Status is 200; Array is not empty; A field exists\r",
              "/* Pattern:\r",
              "pm.test(\"description\", () => {\r",
              "  // expectation\r",
              "});\r",
              "*/\r",
              "pm.test(\"Books API basic validation\", function() {\r",
              "    pm.response.to.have.status(200); // status 200\r",
              "    pm.expect(stock.length).to.be.above(0); // not empty\r",
              "    pm.expect(stock[0]).to.have.property(\"id\"); // field exists\r",
              "});\r",
              "//This only tests the first book (stock[0])\r",
              "const book = stock [0];\r",
              "pm.test(\"First filtered books in stock are available\", function(){\r",
              "    pm.expect(book).to.be.an('object');\r",
              "        pm.expect(book.available).to.eql(true);\r",
              "    });\r",
              "// all  book\r",
              "pm.test(\"All books filtered in stock are available\", function(){\r",
              "    stock.forEach(function(book){\r",
              "        pm.expect(book.available).to.eql(true);\r",
              "    });\r",
              "});\r",
              "\r",
              "\r",
              "console.log(stock); // shows all log for filtered condition\r",
              "console.log (stock[0]);// shows log for the first array filtered condition\r",
              "\r",
              "// is it need to be saved? save something to be used later\r",
              "/* Pattern:\r",
              "pm.environment.set(\"name\", value);\r",
              "*/\r",
              "pm.globals.set(\"bookId\", storeres[0].id); // save first book id to use later\r",
              ""
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        }
