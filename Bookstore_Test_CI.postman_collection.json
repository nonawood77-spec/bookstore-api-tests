    {
      "name": "Get Condition book Order ID",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 200\", function () \r",
              "{\r",
              "    pm.response.to.have.status(200);\r",
              "});\r",
              "\r",
              "// 1\ufe0f\u20e3 Parse API response\r",
              "const responseorder = pm.response.json();\r",
              "// Converts the response body into JSON and stores in responseorder.\r",
              "\r",
              "// 2\ufe0f\u20e3 Inspect response\r",
              "// Shows full array of orders in console to verify fields and structure.\r",
              "//console.log(responseorder);\r",
              "\r",
              "// 3\ufe0f\u20e3 Extract only order IDs\r",
              "// Loops through each order object in the array, retrieves `id`, and returns a new array of order IDs.\r",
              "const orderIds = responseorder\r",
              ".filter(function(stockorder){\r",
              "   return stockorder.quantity > 0; \r",
              "})\r",
              ".map(function(stockorder){\r",
              "    return {\r",
              "        id: stockorder.id ,\r",
              "        quantity : stockorder.quantity\r",
              "    };\r",
              "})\r",
              "\r",
              "// 4\ufe0f\u20e3 Log order IDs\r",
              "console.log(orderIds);\r",
              "\r",
              "pm.test(\"Incoming Order more than zero\", function() {\r",
              "   orderIds.forEach(function (idtotal){\r",
              "    pm.expect(idtotal.quantity).to.be.above(0);\r",
              "   })\r",
              "})"
            ],
